# Public endpoint for the Render WebSocket server: wss://<service>.onrender.com/ws
# Leave empty for the local server's same-origin /ws endpoint. This URL is public.
VITE_MULTIPLAYER_URL=

# Render supplies PORT automatically. Pass server variables through its environment.
PORT=
# Exact frontend origins, comma-separated: https://<site>.vercel.app
# Include protocol, hostname, and optional port; omit paths and trailing slashes.
MULTIPLAYER_ALLOWED_ORIGINS=
